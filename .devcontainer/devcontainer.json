{
  "name": "Flutter Web Codespace (Custom Dockerfile)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "flutter doctor"
}